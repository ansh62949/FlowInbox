# FlowInbox AI — Production Environment Configuration Example (Render / Managed Cloud)

# Environment Mode
ENVIRONMENT=production

# Render Managed PostgreSQL
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<render_postgres_host>:5432/<db_name>

# Managed Redis / Key Value
REDIS_URL=redis://<redis_host>:6379/0

# Qdrant Cloud or Managed Vector Database
QDRANT_URL=https://<qdrant_instance>.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
VECTOR_STORE=qdrant

# LLM Providers (Groq & Gemini)
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=your_production_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_production_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Provider
EMBEDDING_PROVIDER=fastembed

# Google OAuth 2.0 Credentials (Gmail & Calendar Production App)
GOOGLE_CLIENT_ID=your_production_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_client_secret
GOOGLE_REDIRECT_URI=https://flowinbox-api.onrender.com/api/v1/auth/google/callback

# Background Gmail Sync Loop Configuration
ENABLE_GMAIL_SYNC=true

# Security & Secrets (Use 256-bit random keys for production)
JWT_SECRET=your_secure_256bit_production_jwt_secret
OAUTH_TOKEN_ENCRYPTION_KEY=your_secure_32byte_fernet_encryption_key

# Frontend Production Domain (Vercel)
FRONTEND_URL=https://flowinbox-ai.vercel.app
FRONTEND_ORIGINS=https://flowinbox-ai.vercel.app
