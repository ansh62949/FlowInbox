# FlowInbox AI — Production Environment Configuration Template
# DO NOT commit real secrets to source control!

# Environment & Server Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="FlowInbox AI"
API_V1_STR="/api/v1"

# Database Configuration (Real PostgreSQL Instance)
DATABASE_URL=postgresql+asyncpg://flowinbox_admin:SECURE_PG_PASSWORD@postgres.production.internal:5432/flowinbox_prod_db
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis.production.internal:6379/0

# Vector Database (Real Qdrant Cluster / Instance)
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant.production.internal:6333

# Primary & Fallback LLM Credentials
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=gsk_real_production_groq_api_key_here
GEMINI_API_KEY=AIzaSy_real_production_gemini_api_key_here
GROQ_MODEL=groq/compound-mini
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth Credentials (Google Cloud Console with Gmail & Calendar API Scopes)
GOOGLE_CLIENT_ID=real_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-real_client_secret_here
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/api/v1/auth/google/callback

# Security & CORS Settings
FRONTEND_ORIGINS=["https://app.yourdomain.com","https://flowinbox.ai"]
JWT_SECRET=generatated_64_character_hex_string_for_production_jwt_signing_key
OAUTH_TOKEN_ENCRYPTION_KEY=exact_32_character_fernet_encryption_secret_key!
