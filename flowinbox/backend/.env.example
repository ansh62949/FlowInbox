# FlowInbox AI — Environment Configuration Example

# Database & Cache (Local / Development)
DATABASE_URL=postgresql+asyncpg://flowinbox_user:flowinbox_password@localhost:5432/flowinbox_db
REDIS_URL=redis://localhost:6379/0

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
VECTOR_STORE=qdrant

# LLM Providers (Groq & Gemini)
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Provider
EMBEDDING_PROVIDER=fastembed

# Google OAuth 2.0 Credentials (Gmail & Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Background Gmail Sync Loop (True / False)
ENABLE_GMAIL_SYNC=true

# Security & Encryption Keys
JWT_SECRET=super_secret_jwt_key_change_in_production
OAUTH_TOKEN_ENCRYPTION_KEY=32_byte_base64_encryption_key_here

# Application Base URLs
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
