# Database and Caching
DATABASE_URL=postgresql+asyncpg://flowinbox_user:flowinbox_password@localhost:5432/flowinbox_db
REDIS_URL=redis://localhost:6379/0

# Vector Store
QDRANT_URL=http://localhost:6333
VECTOR_STORE=qdrant

# LLM Providers (Groq primary, Gemini fallback)
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# Embeddings
EMBEDDING_PROVIDER=fastembed

# Observability (Optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flowinbox-ai

# Google OAuth Integrations
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Application Security
JWT_SECRET=super_secret_jwt_key_change_in_production
OAUTH_TOKEN_ENCRYPTION_KEY=32_byte_base64_encryption_key_here
