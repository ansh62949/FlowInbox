apiVersion: v1
kind: Secret
metadata:
  name: flowinbox-secrets
  namespace: flowinbox
type: Opaque
stringData:
  # Database & Cache Connection Strings (matching k8s internal service DNS names)
  DATABASE_URL: "postgresql+asyncpg://flowinbox_user:flowinbox_password@postgres:5432/flowinbox_db"
  POSTGRES_USER: "flowinbox_user"
  POSTGRES_PASSWORD: "flowinbox_password"
  POSTGRES_DB: "flowinbox_db"
  REDIS_URL: "redis://redis:6379/0"
  QDRANT_URL: "http://qdrant:6333"

  # API Keys & Sensitive Secrets (Replace with real local backend/.env values)
  GROQ_API_KEY: "REPLACE_ME_WITH_REAL_GROQ_API_KEY"
  GEMINI_API_KEY: "REPLACE_ME_WITH_REAL_GEMINI_API_KEY"
  GOOGLE_CLIENT_ID: "REPLACE_ME_WITH_REAL_GOOGLE_CLIENT_ID"
  GOOGLE_CLIENT_SECRET: "REPLACE_ME_WITH_REAL_GOOGLE_CLIENT_SECRET"
  GOOGLE_REDIRECT_URI: "http://localhost/api/v1/auth/google/callback"
  JWT_SECRET: "REPLACE_ME_WITH_SUPER_SECRET_JWT_KEY"
  OAUTH_TOKEN_ENCRYPTION_KEY: "REPLACE_ME_WITH_32_BYTE_ENCRYPTION_KEY"
  LANGSMITH_API_KEY: ""
